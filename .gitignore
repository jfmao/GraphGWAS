# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
*.env

# Secrets — NEVER commit these
*token*.txt
*token*.json
*_token*
*api_key*
.zenodo_token
.pypi_token

# Zenodo upload bookkeeping (machine-generated per upload)
zenodo/.last_deposit_id
zenodo/.last_bucket

# Data (large files)
tests/data/*.vcf
tests/data/*.vcf.gz
tests/data/*.bed
tests/data/*.bim
tests/data/*.fam
tests/data/yeast/
tests/data/human/
tests/data/arabidopsis/
tests/data/sim/
data/
import.report
docs/*.pdf

# Output
*.png
*.pdf
*.pt
*.tsv
results/

# Neo4j
neo4j-data/
plugins/

# OS
.DS_Store
Thumbs.db

# Neo4j database backups
backups/

# Development tool configuration
CLAUDE.md
.claude/

# LaTeX build artefacts
*.aux
*.log
*.out
*.bbl
*.blg
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Test / coverage artefacts
.coverage

# External tabix index files (Pan-UKB downloads etc.; should live outside repo)
*.tbi
*.tsv.bgz
*.tsv.bgz.tbi

# Allow the three deferred-experiment outputs (placebo, null-overlap,
# hyperparameter sensitivity) and the consolidated report to be tracked,
# even though the parent results/ directory is otherwise gitignored.
!results/null_overlap/
!results/null_overlap/*.json
!results/null_overlap/*.tsv
!results/hyperparam_sensitivity/
!results/hyperparam_sensitivity/*.json
!results/hyperparam_sensitivity/*.tsv
!results/placebo_prior/
!results/placebo_prior/*.json
!results/deferred_experiments_report.md
